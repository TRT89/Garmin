# ---------------------------------------------------------------------------
# Garmin AI Coach — environment configuration
#
# HOW TO USE:
#   1. Copy this file to `.env`   ->   cp .env.example .env
#   2. Edit `.env` (never edit or commit this example file with real values)
#
# The app runs fully with these defaults. Nothing here costs money.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local SQLite file. No cloud database, no account, no cost.
DATABASE_URL="file:./dev.db"

# --- Demo mode -------------------------------------------------------------
# "true" enables the "Load Demo Athlete" button and the simulated sync so you
# can try every feature without a Garmin account.
DEMO_MODE="true"

# --- Garmin Connect Developer API (OPTIONAL, disabled by default) -----------
# Requires approval from the Garmin Connect Developer Program.
# Leave GARMIN_ENABLED="false" unless you have been granted credentials.
# The app works completely without this — use FIT upload or demo data instead.
GARMIN_ENABLED="false"
GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""
# The URL Garmin should redirect back to after you authorise the app.
GARMIN_REDIRECT_URI="http://localhost:3000/api/garmin/callback"

# --- Garmin Connect sign-in (OPTIONAL, unofficial) --------------------------
# Your ordinary Garmin Connect email and password — the ones you use on the
# website. This reads your own data through endpoints Garmin has not documented.
#
# Understand the trade-off before using it:
#   * It needs no approval and works immediately.
#   * It is reverse-engineered, so Garmin can break it without warning.
#   * It is likely contrary to Garmin's terms of service.
#   * It does not work if your account has two-factor authentication enabled.
#
# Your password stays in this file (which git ignores), is never logged, and
# never leaves your machine. After the first sign-in the session is cached to
# .garmin-session.json so the password is not sent again.
#
# Leave both blank to disable. FIT file upload gives you the same data.
GARMIN_CONNECT_EMAIL=""
GARMIN_CONNECT_PASSWORD=""

# --- AI Coach language model (OPTIONAL, free, runs on your own machine) -----
# The AI Coach uses Ollama, a free local LLM runner: https://ollama.com
# Without it the coach still answers using built-in templates and your real
# data — you simply get plainer wording.
#
#   brew install ollama
#   ollama serve
#   ollama pull llama3.1:8b
#
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# Advanced: any server speaking the OpenAI chat-completions format can be used
# instead by pointing OLLAMA_BASE_URL at it (for example LM Studio on
# http://localhost:1234). No paid service is required or configured by default.
